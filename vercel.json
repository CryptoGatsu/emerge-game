{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/dividend?sample=1",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/dividend?settle=1",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/vault",
      "schedule": "0 5 * * *"
    }
  ]
}
